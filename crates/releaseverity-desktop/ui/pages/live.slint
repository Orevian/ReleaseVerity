import { Theme, Tr } from "../theme.slint";
import { AppState, LiveStep } from "../state.slint";
import { Panel, Button, StatusGlyph, Badge, SectionLabel, Divider, Mono, Icon } from "../widgets.slint";
import { ScrollView } from "std-widgets.slint";

/// A step state: -1 pending · 0 running (real, from the engine's events) · 1.. final result.
component StepState inherits Rectangle {
    in property <int> status;
    width: 18px;
    height: 18px;
    if root.status == -1: Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border-strong;
        x: 5px;
        y: 5px;
    }
    if root.status == 0: Icon {
        source: @image-url("../icons/spinner.svg");
        size: 16px;
        tint: Theme.accent;
        rotate: 360deg * mod(animation-tick() / 900ms, 1);
        x: 1px;
        y: 1px;
    }
    if root.status >= 1: StatusGlyph { status: root.status; size: 17px; }
}

export component LivePage inherits Rectangle {
    background: Theme.bg;
    VerticalLayout {
        padding: 28px;
        spacing: 18px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                Text { text: AppState.live-title; color: Theme.text; font-size: 20px; font-weight: 600; overflow: elide; }
                Text {
                    text: AppState.live-running ? Tr.t("live.running") + "  ·  " + AppState.live-done + " / " + AppState.live-total : Tr.t("live.finished");
                    color: Theme.muted;
                    font-size: 13px;
                }
            }
            if AppState.live-running: Button {
                text: Tr.t("action.cancel");
                icon: @image-url("../icons/stop.svg");
                danger: true;
                clicked => { AppState.live-cancel(); }
            }
        }

        // Real progress: the bar is done-steps / total-steps from engine events — never a timer.
        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.border;
            Rectangle {
                x: 0px;
                width: AppState.live-total <= 0 ? 0px : parent.width * AppState.live-done / AppState.live-total;
                border-radius: 2px;
                background: Theme.accent;
                animate width { duration: 180ms; easing: ease-out; }
            }
        }

        Panel {
            vertical-stretch: 1;
            ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    for s[i] in AppState.live-steps: Rectangle {
                        height: s.status == 0 ? 62px : 42px;
                        if i > 0: Divider { y: 0px; }
                        background: s.status == 0 ? Theme.selected.with-alpha(0.5) : transparent;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 16px;
                            spacing: 12px;
                            Rectangle {
                                width: 18px;
                                StepState { status: s.status; y: (parent.height - self.height) / 2; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 3px;
                                Text {
                                    text: s.title;
                                    color: s.status == -1 ? Theme.muted : Theme.text;
                                    font-size: 13px;
                                    font-weight: s.status == 0 ? 600 : 500;
                                    overflow: elide;
                                }
                                if s.message != "": Text { text: s.message; color: Theme.muted; font-size: 12px; overflow: elide; }
                            }
                            if s.env != "": Rectangle {
                                width: 120px;
                                HorizontalLayout { alignment: end; Badge { text: s.env; y: (parent.height - self.height) / 2; } }
                            }
                        }
                    }
                }
            }
        }
        if !AppState.live-running && AppState.detail-id > 0: HorizontalLayout {
            padding-bottom: 20px;
            alignment: end;
            Button {
                text: Tr.t("live.open-result");
                primary: true;
                clicked => { AppState.open-run(AppState.detail-id); }
            }
        }
    }
}
