import { Theme, Tr } from "theme.slint";

export component Icon inherits Rectangle {
    in property <image> source;
    in property <color> tint: Theme.muted;
    in property <length> size: 16px;
    in property <angle> rotate: 0deg;
    width: size;
    height: size;
    Image {
        source: root.source;
        transform-rotation: root.rotate;
        colorize: root.tint;
        width: root.size;
        height: root.size;
    }
}

/// Pass / warn / fail / skipped / error glyph, drawn from the same icon set.
export component StatusGlyph inherits Rectangle {
    in property <int> status;     // see Theme.status-color
    in property <length> size: 16px;
    width: size;
    height: size;
    Icon {
        size: root.size;
        tint: Theme.status-color(root.status);
        source: root.status == 1 ? @image-url("icons/check.svg")
              : root.status == 2 ? @image-url("icons/alert.svg")
              : root.status == 3 ? @image-url("icons/x.svg")
              : root.status == 5 ? @image-url("icons/alert.svg")
              : @image-url("icons/minus.svg");
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.muted;
    height: 20px;
    border-radius: 4px;
    background: tone.with-alpha(0.14);
    border-width: 1px;
    border-color: tone.with-alpha(0.45);
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text {
            text: root.text;
            color: root.tone;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component VerdictBadge inherits Badge {
    in property <int> verdict;   // 0 none · 1 verified · 2 warnings · 3 failed · 4 inconclusive
    tone: verdict == 1 ? Theme.pass : verdict == 2 ? Theme.warn : verdict == 3 ? Theme.fail : Theme.muted;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    min-width: 32px;
    border-radius: Theme.radius;
    opacity: enabled ? 1.0 : 0.45;
    border-width: primary ? 0px : 1px;
    border-color: danger ? Theme.fail.with-alpha(0.6) : Theme.border-strong;
    background: primary ? (ta.has-hover && enabled ? Theme.accent-hover : Theme.accent)
              : (ta.has-hover && enabled ? Theme.hover : Theme.panel);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;
        if root.icon.width > 0: Icon {
            source: root.icon;
            size: 15px;
            tint: root.primary ? Theme.accent-text : root.danger ? Theme.fail : Theme.text;
            y: (parent.height - self.height) / 2;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.primary ? Theme.accent-text : root.danger ? Theme.fail : Theme.text;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <angle> rotate: 0deg;
    in property <bool> enabled: true;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 5px;
    background: ta.has-hover && enabled ? Theme.hover : transparent;
    opacity: enabled ? 1.0 : 0.4;
    Icon {
        source: root.icon;
        rotate: root.rotate;
        size: 15px;
        tint: Theme.muted;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono: false;
    in property <bool> read-only: false;
    in property <bool> password: false;
    callback edited(string);
    callback accepted(string);
    height: 32px;
    border-radius: Theme.radius;
    background: Theme.bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border-strong;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Rectangle {
            input := TextInput {
                width: parent.width;
                height: 32px;
                text <=> root.text;
                font-size: 13px;
                font-family: root.mono ? Theme.mono : "";
                color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                read-only: root.read-only;
                selection-background-color: Theme.accent.with-alpha(0.4);
                selection-foreground-color: Theme.text;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted(self.text);
                }
            }
            if root.text == "" && !input.has-focus: Text {
                text: root.placeholder;
                color: Theme.muted;
                font-size: 13px;
                font-family: root.mono ? Theme.mono : "";
                x: 0px;
                width: parent.width;
                horizontal-alignment: left;
                vertical-alignment: center;
                height: parent.height;
                overflow: elide;
            }
        }
    }
}

export component TextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono: true;
    callback edited(string);
    min-height: 90px;
    border-radius: Theme.radius;
    background: Theme.bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border-strong;
    Rectangle {
        x: 10px;
        y: 8px;
        width: parent.width - 20px;
        height: parent.height - 16px;
        input := TextInput {
            width: parent.width;
            height: parent.height;
            text <=> root.text;
            font-size: 12px;
            font-family: root.mono ? Theme.mono : "";
            color: Theme.text;
            wrap: word-wrap;
            single-line: false;
            selection-background-color: Theme.accent.with-alpha(0.4);
            selection-foreground-color: Theme.text;
            edited => {
                root.edited(self.text);
            }
        }
        if root.text == "" && !input.has-focus: Text {
            text: root.placeholder;
            color: Theme.muted;
            font-size: 12px;
            font-family: root.mono ? Theme.mono : "";
            wrap: word-wrap;
            width: parent.width;
        }
    }
}

export component Switch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: checked ? Theme.accent : Theme.border-strong;
    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #ffffff;
        y: 3px;
        x: root.checked ? 17px : 3px;
        animate x { duration: 100ms; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component CheckBox inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <string> note;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: note == "" ? 28px : 44px;
    opacity: enabled ? 1.0 : 0.5;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 18px;
            Rectangle {
                y: 5px;
                width: 16px;
                height: 16px;
                border-radius: 4px;
                background: root.checked ? Theme.accent : Theme.bg;
                border-width: 1px;
                border-color: root.checked ? Theme.accent : Theme.border-strong;
                if root.checked: Icon {
                    source: @image-url("icons/check.svg");
                    size: 12px;
                    tint: Theme.accent-text;
                    x: 2px;
                    y: 2px;
                }
            }
        }
        VerticalLayout {
            padding-top: 3px;
            spacing: 2px;
            Text {
                text: root.text;
                color: Theme.text;
                font-size: 13px;
            }
            if root.note != "": Text {
                text: root.note;
                color: Theme.muted;
                font-size: 11px;
            }
        }
    }
    TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

/// Radio-style option used by the wizard and settings.
export component Choice inherits Rectangle {
    in property <string> text;
    in property <string> note;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    height: note == "" ? 38px : 56px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: selected ? Theme.accent : Theme.border;
    background: selected ? Theme.selected : (ta.has-hover && enabled ? Theme.hover : Theme.panel);
    opacity: enabled ? 1.0 : 0.5;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Rectangle {
            width: 16px;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1px;
                border-color: selected ? Theme.accent : Theme.border-strong;
                background: Theme.bg;
                y: (parent.height - self.height) / 2;
                if selected: Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                    x: 3px;
                    y: 3px;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.text;
                color: Theme.text;
                font-size: 13px;
                font-weight: 500;
                overflow: elide;
            }
            if root.note != "": Text {
                text: root.note;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

export component Panel inherits Rectangle {
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component PageTitle inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 12px;
    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 20px;
            font-weight: 600;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.muted;
            font-size: 13px;
        }
    }
}

export component SectionLabel inherits Text {
    color: Theme.muted;
    font-size: 11px;
    font-weight: 600;
}

export component Mono inherits Text {
    color: Theme.text;
    font-family: Theme.mono;
    font-size: 12px;
}

/// Score as a thin bar + number (no decorative widgets).
export component ScoreBar inherits Rectangle {
    in property <int> score;     // -1 = none
    in property <int> verdict;
    height: 18px;
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 4px;
                border-radius: 2px;
                background: Theme.border;
                Rectangle {
                    x: 0px;
                    width: root.score < 0 ? 0px : parent.width * root.score / 100;
                    border-radius: 2px;
                    background: root.verdict == 1 ? Theme.pass : root.verdict == 2 ? Theme.warn : root.verdict == 3 ? Theme.fail : Theme.muted;
                }
            }
        }
        Text {
            width: 26px;
            text: root.score < 0 ? "–" : root.score;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    in property <string> action;
    in property <image> icon;
    callback clicked();
    alignment: center;
    spacing: 10px;
    padding: 40px;
    Icon {
        source: root.icon;
        size: 28px;
        tint: Theme.border-strong;
        x: (parent.width - self.width) / 2;
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
    }
    Text {
        text: root.body;
        color: Theme.muted;
        font-size: 12px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.action != "": HorizontalLayout {
        alignment: center;
        Button {
            text: root.action;
            primary: true;
            clicked => {
                root.clicked();
            }
        }
    }
}
